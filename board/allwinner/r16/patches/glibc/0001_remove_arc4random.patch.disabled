diff -urN glibc-2.39-74-g198632a05f6c7b9ab67d3331d8caace9ceabb685/stdlib/stdlib.h new_glibc-2.39-74-g198632a05f6c7b9ab67d3331d8caace9ceabb685/stdlib/stdlib.h
