#!/bin/sh

case "$1" in
    headphone)
        amixer -c 0 sset Headphone 4
        amixer -c 0 sset LINEOUT off
        ;;
    speaker)
        amixer -c 0 sset Headphone 1
        amixer -c 0 sset LINEOUT on
        ;;
    *)
        echo "Usage: $0 [speaker|headphone]" >&2
        exit 1
        ;;
esac
